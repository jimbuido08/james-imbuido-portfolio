# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Allow committing the example env file
!.env.example

# Claude Code local settings (machine-specific; never share)
.claude/settings.local.json

# Playwright MCP browser-test artifacts (logs, snapshots, screenshots)
/.playwright-mcp/

# Voice cloning training (Mac-only; gated artifacts are promoted to public/models)
/training/voice/_rtvc-src/
/training/voice/pretrained/
/training/voice/export/
/training/voice/.venv/
# Generated listening-test audio (derived from reference-repo samples + browser drives)
/training/voice/samples/
# The gated fp32 artifacts in public/models/voice/ are committed (~111 MB total,
# each under GitHub's 100 MB per-file cap — synth-step is 74 MB). Git LFS is an
# option if the repo grows; flagged for James, not required to deploy.
